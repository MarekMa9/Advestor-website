RewriteEngine On

# Homepage = bývalá stránka vývoja aplikácií (modrá); staré adresy presmerovať na /
RewriteCond %{THE_REQUEST} \s/(index|vyvoj-aplikacii-blue)(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Remove .html extension
# Redirect requests with .html to clean URL (except index.html)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve .html file for clean URL (if the file exists)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
